<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Coverlet MSBuild settings -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>./coverage/</CoverletOutput>
    <!-- Include the test assembly itself since maze code is compiled into it -->
    <IncludeTestAssembly>true</IncludeTestAssembly>
    <!-- Exclude test classes from coverage -->
    <ExcludeByAttribute>TestFixture</ExcludeByAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.10.0" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <!--
      tests/scene/ holds the in-engine scene tests, which need the Godot SDK this project
      deliberately avoids. They are compiled by the Godot project instead
      (-p:IncludeSceneTests=true). Without this exclusion, default globbing pulls them in here
      and the build fails on the missing Godot namespace.
    -->
    <Compile Remove="scene\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include maze logic files directly (avoiding Godot SDK dependency) -->
    <Compile Include="..\scripts\maze\**\*.cs" Link="Maze\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\scripts\autoload\ServiceContainer.cs" Link="Autoload\ServiceContainer.cs" />
    <!--
      The test bridge's wire format is Godot-free precisely so it can be covered here.
      TestBridge.cs itself is a Godot Node and cannot be compiled without the Godot SDK.
    -->
    <Compile Include="..\scripts\testing\TestBridgeProtocol.cs" Link="Testing\TestBridgeProtocol.cs" />

    <!--
      Application behaviour that carries no Godot dependency, so it belongs in this fast suite
      rather than behind the engine. See docs/TESTING.md -> "Segregating behaviour from Godot".
      Adding a file here is a claim that it is Godot-free; the build enforces that claim.
    -->
    <Compile Include="..\scripts\session\MazeSession.cs" Link="Session\MazeSession.cs" />
    <Compile Include="..\scripts\ui\AnimationController.cs" Link="UI\AnimationController.cs" />
    <Compile Include="..\scripts\ui\ImportExportResult.cs" Link="UI\ImportExportResult.cs" />
    <Compile Include="..\scripts\ui\GraphLayoutType.cs" Link="UI\GraphLayoutType.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include shared sample maze files as content -->
    <Content Include="..\sample-data\*.maze" Link="sample-data\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
