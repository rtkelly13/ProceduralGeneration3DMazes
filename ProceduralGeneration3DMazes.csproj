<!--
  Godot.NET.Sdk version is version-locked to the patched web-export editor and its
  export templates (.github/web-toolchain.env). The export action's drift guard
  fails the build if they disagree — bump them together.
-->
<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <!-- net9.0 alongside the Godot 4.7 engine bump (supported for desktop, tests, and editor). -->
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Prevent duplicate assembly attributes when building from CLI alongside Godot -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!--
    Web-only settings. The .NET WASM runtime needs an executable entry point
    (Program.cs) and runs with globalization data trimmed out (invariant mode).
    None of this applies to the desktop/library build. See docs/WEB_EXPORT.md.
  -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude test and experiment files from Godot build -->
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="experiments\**\*.cs" />
    <Compile Remove="benchmarks\**\*.cs" />
  </ItemGroup>

  <!--
    In-engine scene tests, added back after the blanket removal above (order matters in
    MSBuild). Opt-in via -p:IncludeSceneTests=true so the runner never ships in a game
    export; CI passes it for the headless scene-test job. See docs/TESTING.md.
  -->
  <ItemGroup Condition=" '$(IncludeSceneTests)' == 'true' ">
    <Compile Include="tests\scene\*.cs" />
  </ItemGroup>

  <!--
    Program.cs is the WASM entry point. It MUST NOT be compiled into the normal
    (library) build, otherwise top-level statements trigger CS8805
    ("Program using top-level statements must be an executable").
  -->
  <ItemGroup Condition=" '$(GodotTargetPlatform)' != 'web' ">
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <!-- Keep BCL bits the .NET WASM runtime resolves via reflection from being trimmed. -->
  <ItemGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <TrimmerRootAssembly Include="System.Private.CoreLib" />
    <TrimmerRootAssembly Include="System.Runtime" />
  </ItemGroup>

  <!--
    Stamps the build with the commit it came from, so the About screen (and the test bridge,
    and the post-deploy smoke test) can prove which build is being served.

    Values arrive as MSBuild properties. CI sets them as ENVIRONMENT VARIABLES rather than
    -p: arguments, because the web export is driven by the Godot editor rather than by a
    dotnet build we control the command line of — MSBuild reads environment variables as
    properties, so this is the one channel that works through the editor.

    Unset locally, which is deliberate: a developer build reports itself as one instead of
    inheriting a stale hash from whenever the file was last written.
  -->
  <Target Name="GenerateBuildStamp" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildStampPath>$(IntermediateOutputPath)BuildStamp.g.cs</BuildStampPath>
    </PropertyGroup>
    <ItemGroup>
      <BuildStampLine Include="// &lt;auto-generated /&gt; Written by the GenerateBuildStamp target. Do not edit or commit." />
      <BuildStampLine Include="namespace ProceduralMaze.Build" />
      <BuildStampLine Include="{" />
      <BuildStampLine Include="    internal static class BuildStamp" />
      <BuildStampLine Include="    {" />
      <BuildStampLine Include="        public const string Commit = &quot;$(BuildCommit)&quot;%3B" />
      <BuildStampLine Include="        public const string Branch = &quot;$(BuildBranch)&quot;%3B" />
      <BuildStampLine Include="        public const string Repository = &quot;$(BuildRepository)&quot;%3B" />
      <BuildStampLine Include="        public const string RunId = &quot;$(BuildRunId)&quot;%3B" />
      <BuildStampLine Include="        public const string RunAttempt = &quot;$(BuildRunAttempt)&quot;%3B" />
      <BuildStampLine Include="        public const string TimestampUtc = &quot;$(BuildTimestampUtc)&quot;%3B" />
      <BuildStampLine Include="    }" />
      <BuildStampLine Include="}" />
    </ItemGroup>
    <!--
      WriteOnlyWhenDifferent keeps incremental builds incremental: without it every build
      rewrites the file and forces a full recompile of the project.
    -->
    <WriteLinesToFile File="$(BuildStampPath)"
                      Lines="@(BuildStampLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildStampPath)" />
      <FileWrites Include="$(BuildStampPath)" />
    </ItemGroup>
  </Target>
</Project>
