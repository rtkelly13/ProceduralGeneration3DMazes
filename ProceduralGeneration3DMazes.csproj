<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <!-- net9.0 alongside the Godot 4.7 engine bump (supported for desktop, tests, and editor). -->
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Prevent duplicate assembly attributes when building from CLI alongside Godot -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Exclude test and experiment files from Godot build -->
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="experiments\**\*.cs" />
    <Compile Remove="benchmarks\**\*.cs" />
  </ItemGroup>
</Project>
