# Godot 4+ specific ignores
.godot/

# Mono/C# build artifacts
.mono/
bin/
obj/

# Web export output
build/

# Test coverage output
tests/coverage/
tests/coveragereport/
tests/TestResults/

# Benchmark results
BenchmarkDotNet.Artifacts/
