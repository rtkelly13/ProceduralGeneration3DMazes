<!--
  Godot.NET.Sdk version is version-locked to the patched web-export editor and its
  export templates (.github/web-toolchain.env). The export action's drift guard
  fails the build if they disagree — bump them together.
-->
<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <!-- net9.0 alongside the Godot 4.7 engine bump (supported for desktop, tests, and editor). -->
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Prevent duplicate assembly attributes when building from CLI alongside Godot -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!--
    Web-only settings. The .NET WASM runtime needs an executable entry point
    (Program.cs) and runs with globalization data trimmed out (invariant mode).
    None of this applies to the desktop/library build. See docs/WEB_EXPORT.md.
  -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude test and experiment files from Godot build -->
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="experiments\**\*.cs" />
    <Compile Remove="benchmarks\**\*.cs" />
  </ItemGroup>

  <!--
    Program.cs is the WASM entry point. It MUST NOT be compiled into the normal
    (library) build, otherwise top-level statements trigger CS8805
    ("Program using top-level statements must be an executable").
  -->
  <ItemGroup Condition=" '$(GodotTargetPlatform)' != 'web' ">
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <!-- Keep BCL bits the .NET WASM runtime resolves via reflection from being trimmed. -->
  <ItemGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <TrimmerRootAssembly Include="System.Private.CoreLib" />
    <TrimmerRootAssembly Include="System.Runtime" />
  </ItemGroup>
</Project>
